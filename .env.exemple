# Database credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# pgAdmin login
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Prisma database URL (used by schema.prisma)
# make sure the user/password/db match the postgres container above
DATABASE_URL=

RABBITMQ_HOST=172.17.0.1       # Linux (host depuis un container)
# RABBITMQ_HOST=host.docker.internal  # Mac / Windows

RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Compte orchestrateur
RABBITMQ_ORCHESTRATOR_USER=
RABBITMQ_ORCHESTRATOR_PASSWORD=

# Compte scraper
RABBITMQ_SCRAPER_USER=
RABBITMQ_SCRAPER_PASSWORD=

# Compte admin
RABBITMQ_ADMIN_USER=
RABBITMQ_ADMIN_PASSWORD=

# Compte DB (consommateur q.db)
RABBITMQ_DB_USER=
RABBITMQ_DB_PASSWORD=

# Authentification
# AUTH_SECRET : 32 caractères minimum, ex. `openssl rand -hex 32`
AUTH_SECRET=
# Client OAuth 2.0 "Application Web" créé sur console.cloud.google.com
# (origines JavaScript autorisées : http://localhost:3000 et le domaine public)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APP_URL=http://localhost:3000

# Importer Open Icecat (compte gratuit : https://icecat.biz/en/registration)
ICECAT_USER=
ICECAT_PASSWORD=
ICECAT_LANG=fr
# type=CategoryID, séparés par des virgules (un type peut avoir plusieurs catégories).
# IDs relevés le 2026-09-18 ; pour en chercher d'autres :
#   docker compose run --rm importer-icecat categories "<regex sur le nom>"
ICECAT_CATEGORIES=server=156,switch=258,router=244,router=3982,access_point=909,workstation=153,workstation=2282,laptop=151,monitor=222,keyboard=194,mouse=195,printer=235,ups=817,nas=932,rack=240
# daily (delta quotidien) ou full (index complet)
ICECAT_INDEX=daily
# Limite globale d'un passage (0 = sans limite) et plafond par type.
ICECAT_MAX_PRODUCTS=0
ICECAT_MAX_PER_TYPE=40
ICECAT_DELAY_MS=300
# Ignorer les fiches mises à jour avant cette date (AAAAMMJJ). Les plus récentes sont importées en premier.
ICECAT_MIN_UPDATED=20200101
